# NON-SECRET SETTINGS ONLY. This file is committed to a public repo.
# Credentials belong in GitHub Actions secrets, never here.

# Sandbox size: micro (1 vCPU, 2 GiB). Must be a supported cloud shape.
SBX_CPUS=1
SBX_MEMORY=2g

# Agent kit used for the sandbox image.
SBX_AGENT=claude

# Hosts the sandbox may reach besides the Anthropic API and Debian apt
# (which the claude kit already allows). Add your package registries here,
# e.g. "registry.npmjs.org" or "pypi.org,files.pythonhosted.org".
SBX_ALLOW_NETWORK="github.com,api.github.com,*.githubusercontent.com,repo.maven.apache.org,repo1.maven.org"

# Sandbox time-to-live per stage. The sandbox is deleted when it expires.
TTL_PLAN=45m
TTL_IMPLEMENT=2h

# Command that must pass before Claude opens a PR (CI runs the same check).
VERIFY_CMD="mvn -B verify"

# Optional Claude model override (empty = Claude Code default).
CLAUDE_MODEL=
